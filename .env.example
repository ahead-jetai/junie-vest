# Server-only credentials. Never prefix secrets with VITE_.
OPENROUTER_API_KEY=
TAVILY_API_KEY=
# Set a model ID from your OpenRouter account that supports JSON object responses.
OPENROUTER_MODEL=
# Reasoning models need time and completion tokens for both reasoning and the final answer.
# OPENROUTER_TIMEOUT_MS=180000
# OPENROUTER_MAX_TOKENS=12000
# low, medium, high, or provider (omit the reasoning override).
# OPENROUTER_REASONING_EFFORT=low
# Optional: exact externally visible origin when running behind a reverse proxy.
# PUBLIC_ORIGIN=https://your-app.example
# PORT=3000
